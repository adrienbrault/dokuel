{
  "name": "dokuel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "workspaces": [
    "signaling"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:slop": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "diff-coverage": "bun scripts/diff-coverage.ts",
    "ci": "bun run lint && bun run typecheck && bun run typecheck:signaling && bun run test",
    "e2e": "vite build && bunx playwright test",
    "screenshots": "vite build && bunx playwright test e2e/screenshots.spec.ts --reporter=line && bun run screenshots:combine",
    "screenshots:combine": "bun run scripts/combine-screenshots.ts",
    "screenshots:readme": "bun run screenshots && bun run scripts/update-readme-screenshots.ts",
    "typecheck:signaling": "tsc --noEmit -p signaling/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "~1.56.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "oxlint": "1.78.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "y-protocols": "^1.0.7"
  }
}
